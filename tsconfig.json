{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "module": "CommonJS",
    "target": "ES2020",
    "typeRoots": ["./src/types", "./node_modules/@types"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src", "prisma"],
  "exclude": ["node_modules", "dist"]
}
