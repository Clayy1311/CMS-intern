// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id        Int    @id @default(autoincrement())
  fullName  String
  email     String @unique
  company   String
  job       String
  country   String
  avatar    String?  
  password  String?
  refreshToken  String?
  isVerified Boolean @default(false)
  verifyToken String? 

  ownedOrganizations Organizations[] @relation("UserOrganizations")
  collaborations     Collaborators[]
  ownedProjects     PersonalProjects[] @relation("UserProjects")
}

model Organizations {
  id          Int       @id @default(autoincrement())
  name        String
  ownerId     Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner       Users     @relation("UserOrganizations", fields: [ownerId], references: [id])
  projects    Projects[]
}

model Projects {
  id              Int       @id @default(autoincrement())
  organizationId  Int
  name            String
  status          String    @default("Progress")
  customDomain    String? 
  lastUpdated     DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  organization    Organizations @relation(fields: [organizationId], references: [id])
  collaborators   Collaborators[]
  contentModels   ContentModels[]
}

model Collaborators {
  id          Int       @id @default(autoincrement())
  projectId   Int
  userId      Int
  role        String    @default("collaborator") // owner, editor, viewer, etc.
  status      String    @default("active")       // active, pending, etc.
  createdAt   DateTime  @default(now())

   project   Projects  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        Users     @relation(fields: [userId], references: [id])
}

model PersonalProjects {
  id Int @id @default(autoincrement())
  ownerId Int
  name String
  status String @default("Progress")
  customDomain String?
  lastUpdated DateTime  @updatedAt
  createdAt DateTime  @default(now())


  owner Users @relation("UserProjects", fields: [ownerId], references: [id])
  contentModels   ContentModels[]
}

model ContentModels {
  id Int @id @default(autoincrement())
  projectOrgId Int?
  projectPersonalId Int?
  projectType String // "org" or "personal"
  name String
  apiKey String @unique  // e.g. "blog", "product", "landing_page"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  organizationProject Projects? @relation(fields: [projectOrgId], references:[id])
  personalProjects  PersonalProjects? @relation(fields: [projectPersonalId], references:[id]) 
  contentFields ContentFields[]
  fieldsRelated ContentFields[] @relation("FieldRelation")
}

model ContentFields {
  id Int  @id @default(autoincrement())
  contentModelId Int
  name String
  key String
  type String
  required  Boolean @default(false)
  unique Boolean @default(false)
  order Int @default(0)

  validation Json?

  relationType String?  // one-to-one, one-to-many, many-to-many
  relationContentModelId Int? // points to another ContentModels.id

  contentModel ContentModels @relation(fields: [contentModelId], references: [id])
  relatedModel ContentModels? @relation("FieldRelation", fields: [relationContentModelId], references: [id])

   createdAt DateTime @default(now())
  


}