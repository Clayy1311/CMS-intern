// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id        Int    @id @default(autoincrement())
  fullName String @default("Unknown") 
  email     String @unique
  company   String
  job       String
  country   String
  avatar    String?  
  password  String?
  refreshToken  String?
  isVerified Boolean @default(false)
  verifyToken String? 
}


