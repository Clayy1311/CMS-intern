// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id        Int    @id @default(autoincrement())
  fullName  String
  email     String @unique
  company   String
  job       String
  country   String
  avatar    String?  
  password  String?
  refreshToken  String?
  isVerified Boolean @default(false)
  verifyToken String? 
  roleId Int? 
  role Roles? @relation(fields: [roleId], references:[id])
  
  ownedOrganizations Organizations[] @relation("UserOrganizations")
  collaborations     Collaborators[]
  ownedProjects     PersonalProjects[] @relation("UserProjects")
  reviewingEntries ContentEntries[] @relation("EntryReviewer")
  approvingEntries ContentEntries[] @relation("EntryApprover")
  workflowLogs WorkflowLogs[]
  subscription Subscriptions?
}

model Organizations {
  id          Int       @id @default(autoincrement())
  name        String
  ownerId     Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner       Users     @relation("UserOrganizations", fields: [ownerId], references: [id])
  projects    Projects[]
}

model Projects {
  id              Int       @id @default(autoincrement())
  organizationId  Int
  name            String
  status          String    @default("Progress")
  customDomain    String? 
  lastUpdated     DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  organization    Organizations @relation(fields: [organizationId], references: [id],onDelete: Cascade)
  collaborators   Collaborators[]
  contentModels   ContentModels[]
  ContentEntries   ContentEntries[]


}

model Collaborators {
  id          Int       @id @default(autoincrement())
  projectId   Int
  userId      Int
  roleId      Int
  role    Roles   @relation(fields: [roleId], references: [id])
  status      String    @default("active")       // active, pending, etc.
  createdAt   DateTime  @default(now())

   project   Projects  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        Users     @relation(fields: [userId], references: [id])
}

model PersonalProjects {
  id Int @id @default(autoincrement())
  ownerId Int
  name String
  status String @default("Progress")
  customDomain String?
  lastUpdated DateTime  @updatedAt
  createdAt DateTime  @default(now())


  owner Users @relation("UserProjects", fields: [ownerId], references: [id])
  contentModels   ContentModels[]
   ContentEntries   ContentEntries[]
}

model ContentModels {
  id Int @id @default(autoincrement())
  projectOrgId Int? // "org" 
  projectPersonalId Int? //  "personal"
  name String
  slug String @unique // e.g. "blog", "product", "landing_page"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  organizationProject Projects? @relation(fields: [projectOrgId], references:[id])
  personalProjects  PersonalProjects? @relation(fields: [projectPersonalId], references:[id]) 
  contentFields ContentFields[]
  fieldsRelated ContentFields[] @relation("FieldRelation")
  contentEntries ContentEntries[]
}

model ContentFields {
  id Int  @id @default(autoincrement())
  contentModelId Int
  name String
  key String
  type FieldType
  required  Boolean @default(false)
  unique Boolean @default(false)
  order Int @default(0)
  isSystem Boolean @default(false)
  validation Json?

  relationType String?  // one-to-one, one-to-many, many-to-many
  relationContentModelId Int? // points to another ContentModels.id
  contentValues ContentValues[]
  contentField ContentRelations[]
  contentModel ContentModels @relation(fields: [contentModelId], references: [id])
  relatedModel ContentModels? @relation("FieldRelation", fields: [relationContentModelId], references: [id])

   createdAt DateTime @default(now())
  


}

model ContentEntries {
  id Int @id @default(autoincrement())
  contentModelId Int
   projectOrgId Int?
  projectPersonalId Int?
  status ContentStatus @default(DRAFT)
  slug String?
  createdBy Int
  updatedBy Int?
  deletedAt DateTime?
  contentValues ContentValues[]
  contentSEO  ContentSEO?
  workflowEntries WorkflowLogs[]
  sourceEntry ContentRelations[] @relation("SourceEntry")
  targetEntry ContentRelations[] @relation("TargetEntry")
 

  reviewerId Int?
  approvedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scheduledAt DateTime?
  publishedAt DateTime?
  
  contentModel ContentModels @relation(fields: [contentModelId], references: [id])
  organizationProject Projects? @relation(fields: [projectOrgId], references:[id])
  personalProjects  PersonalProjects? @relation(fields: [projectPersonalId], references:[id]) 
  
  reviewer Users? @relation("EntryReviewer", fields: [reviewerId], references: [id])
  approver Users? @relation("EntryApprover", fields: [approvedById], references: [id])

}

model ContentValues {
  id Int @id @default(autoincrement())
  contentEntryId Int
  contentFieldId Int

  valueText String?
  valueNumber Float?
  valueBool Boolean?
  valueDate DateTime? //  rich text / blocks / images / arrays

  

  contentEntry ContentEntries @relation(fields: [contentEntryId], references:[id])
  contentField ContentFields @relation(fields: [contentFieldId], references:[id])
  @@unique([contentEntryId, contentFieldId])
}
model ContentRelations {
  id Int @id @default(autoincrement())
  sourceEntryId Int
  targetEntryId Int
  contentFieldId Int

  sourceEntry ContentEntries @relation("SourceEntry", fields:[sourceEntryId], references:[id])
  targetEntry ContentEntries @relation("TargetEntry", fields:[targetEntryId], references:[id])
  contentField ContentFields @relation(fields:[contentFieldId], references:[id])
}

model ContentSEO {
  id Int @id @default(autoincrement())
  contentEntryId Int @unique
  seoTitle String?
  metaDesc String?
  keywords String?
  ogImage String?
  twitterImage  String?

  updatedAt DateTime @updatedAt

  contentEntry ContentEntries @relation(fields: [contentEntryId], references: [id])

}

model Plans {
  id            Int      @id @default(autoincrement())
  code          String   @unique // free, pro, enterprise
  name          String
  description   String?

  price         Float    // 0, 155, 200
  currency      String   @default("USD")
  interval      String   // month, year

  // limits
  maxUsers              Int?
  maxPersonalProjects   Int?
  maxOrganizations      Int?
  maxProjectsPerOrg     Int?
  maxApiCallsPerMonth   Int?
  maxMediaAssets        Int?

  // features
  seoEnabled        Boolean @default(false)
  aiEnabled         Boolean @default(false)
  customDomain      Boolean @default(false)

  isActive      Boolean @default(true)
  isPublic      Boolean @default(true)

  stripePriceId String? // diisi setelah create di Stripe

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscriptions[]
}


model Subscriptions {
  id       Int @id @default(autoincrement())

  planId   Int
  userId   Int?  @unique 
  organizationId Int?

  status   String // active, trialing, canceled, expired
  startAt DateTime?
  endAt   DateTime?
  invoiceUrl String?
  stripeSubscriptionId String? @unique

  plan Plans @relation(fields: [planId], references: [id])
  user Users? @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Roles {
  id Int @id @default(autoincrement())
  name String @unique 
  scope String // "global" or "project"
  description String?
  permissions Json?

  collaborators Collaborators[]
  users Users[]
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  SCHEDULED
}

enum FieldType {
  TEXT
  RICHTEXT
  NUMBER
  BOOLEAN
  DATE
  IMAGE
  RELATION
  JSON
}

model WorkflowLogs {
  id Int @id @default(autoincrement())
  entryId Int
  fromStatus ContentStatus
  toStatus ContentStatus
  changedBy Int
  note String?
  createdAt DateTime @default(now())

  entry ContentEntries @relation(fields: [entryId], references: [id])
  user Users @relation(fields: [changedBy], references: [id])
}
