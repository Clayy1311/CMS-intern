// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id        Int    @id @default(autoincrement())
  fullName  String
  email     String @unique
  company   String
  job       String
  country   String
  avatar    String?  
  password  String?
  refreshToken  String?
  isVerified Boolean @default(false)
  verifyToken String? 

  ownedOrganizations Organizations[] @relation("UserOrganizations")
  collaborations     Collaborators[]
}

model Organizations {
  id          Int       @id @default(autoincrement())
  name        String
  ownerId     Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner       Users     @relation("UserOrganizations", fields: [ownerId], references: [id])
  projects    Projects[]
}

model Projects {
  id              Int       @id @default(autoincrement())
  organizationId  Int
  name            String
  status          String    @default("Progress")
  customDomain    String? 
  lastUpdated     DateTime  @default(now())
  createdAt       DateTime  @default(now())

  organization    Organizations @relation(fields: [organizationId], references: [id])
  collaborators   Collaborators[]
}

model Collaborators {
  id          Int       @id @default(autoincrement())
  projectId   Int
  userId      Int
  role        String    @default("collaborator") // owner, editor, viewer, etc.
  status      String    @default("active")       // active, pending, etc.
  createdAt   DateTime  @default(now())

  project     Projects  @relation(fields: [projectId], references: [id])
  user        Users     @relation(fields: [userId], references: [id])
}

